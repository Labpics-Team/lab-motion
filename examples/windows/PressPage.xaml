<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="NativeWindow.PressPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Spacing="20" Padding="32">
    <TextBlock Text="LabMotion" FontSize="24" />
    <TextBlock Text="Нажатие мышью, касанием или пробелом" TextWrapping="Wrap" />
    <Button x:Name="Press" AutomationProperties.AutomationId="Press" HorizontalAlignment="Left" Padding="0">
      <Grid MinWidth="240" MinHeight="64">
        <Border x:Name="Highlight" Background="{ThemeResource SystemControlHighlightAccentBrush}"
                Opacity="0" CornerRadius="4" />
        <TextBlock Text="Удерживайте кнопку" Margin="20" HorizontalAlignment="Center"
                   VerticalAlignment="Center" IsHitTestVisible="False" />
      </Grid>
    </Button>
    <CheckBox x:Name="Animation" AutomationProperties.AutomationId="Animation" IsChecked="True" Content="Анимация" />
    <TextBlock x:Name="State" AutomationProperties.AutomationId="State" Text="Отпущено" />
  </StackPanel>
</Page>
